# Строка подключения к облачному Postgres (Neon/Supabase). Для Neon/Supabase
# обычно нужен ?sslmode=require в конце.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# SSL к БД: require (по умолчанию, нужно для Neon) или disable (локальный Postgres без SSL)
# DATABASE_SSL=disable

# Любая случайная строка, например: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Через запятую, без пробелов вокруг запятой не обязательно
CORS_ORIGINS=http://localhost:5173
